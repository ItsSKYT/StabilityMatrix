<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StabilityMatrix.Avalonia.Controls"
    xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
    xmlns:inference="clr-namespace:StabilityMatrix.Avalonia.ViewModels.Inference"
    xmlns:lang="clr-namespace:StabilityMatrix.Avalonia.Languages"
    xmlns:sg="clr-namespace:SpacedGridControl.Avalonia;assembly=SpacedGridControl.Avalonia"
    x:DataType="inference:MiniMaxH3ModelCardViewModel">
    <Style Selector="controls|MiniMaxH3ModelCard">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <controls:Card Padding="12">
                    <sg:SpacedGrid
                        ColumnDefinitions="100,*,Auto"
                        ColumnSpacing="8"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                        RowSpacing="0">
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{x:Static lang:Resources.Label_Model}"
                            TextAlignment="Left" />
                        <controls:BetterComboBox
                            Grid.Column="1"
                            Padding="8,6,4,6"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding ClientManager.UnetModels}"
                            SelectedItem="{Binding SelectedModel}"
                            Theme="{StaticResource BetterComboBoxHybridModelTheme}" />
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Stretch"
                            Command="{Binding OpenModelPickerCommand}">
                            <fluent:SymbolIcon FontSize="16" Symbol="Search" />
                        </Button>

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            VerticalAlignment="Center"
                            Text="Text Encoder" />
                        <controls:BetterComboBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            Padding="8,6,4,6"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding ClientManager.ClipModels}"
                            SelectedItem="{Binding SelectedClipModel}"
                            Theme="{StaticResource BetterComboBoxHybridModelTheme}" />

                        <TextBlock
                            Grid.Row="2"
                            Margin="0,8,0,0"
                            VerticalAlignment="Center"
                            Text="Video VAE" />
                        <controls:BetterComboBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            Padding="8,6,4,6"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding ClientManager.VaeModels}"
                            SelectedItem="{Binding SelectedVideoVae}"
                            Theme="{StaticResource BetterComboBoxHybridModelTheme}" />

                        <TextBlock
                            Grid.Row="3"
                            Margin="0,8,0,0"
                            VerticalAlignment="Center"
                            Text="Audio VAE" />
                        <controls:BetterComboBox
                            Grid.Row="3"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            Padding="8,6,4,6"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding ClientManager.VaeModels}"
                            SelectedItem="{Binding SelectedAudioVae}"
                            Theme="{StaticResource BetterComboBoxHybridModelTheme}" />

                        <CheckBox
                            Grid.Row="4"
                            Grid.ColumnSpan="3"
                            Margin="0,8,0,0"
                            Content="Turbo LoRA"
                            IsChecked="{Binding EnableTurbo}" />
                        <controls:BetterComboBox
                            Grid.Row="5"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            IsVisible="{Binding EnableTurbo}"
                            Padding="8,6,4,6"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding ClientManager.LoraModels}"
                            SelectedItem="{Binding SelectedTurboLora}"
                            Theme="{StaticResource BetterComboBoxHybridModelTheme}" />
                    </sg:SpacedGrid>
                </controls:Card>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
