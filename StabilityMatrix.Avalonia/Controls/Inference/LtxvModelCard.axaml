<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StabilityMatrix.Avalonia.Controls"
    xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
    xmlns:inference="clr-namespace:StabilityMatrix.Avalonia.ViewModels.Inference"
    xmlns:lang="clr-namespace:StabilityMatrix.Avalonia.Languages"
    xmlns:sg="clr-namespace:SpacedGridControl.Avalonia;assembly=SpacedGridControl.Avalonia"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    x:DataType="inference:LtxvModelCardViewModel">
    <Style Selector="controls|LtxvModelCard">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <controls:Card Padding="12">
                    <sg:SpacedGrid
                        ColumnDefinitions="100,*,Auto"
                        ColumnSpacing="8"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                        RowSpacing="0">
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="Version"
                            TextAlignment="Left" />
                        <ui:FAComboBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding VersionOptions}"
                            SelectedItem="{Binding SelectedVersionLabel}"
                            ToolTip.Tip="LTX 2.3: DualCLIP + text projection. LTX 2.5: CLIPLoader Gemma, CFGGuider, I2V ImgToVideoInplace. Two-stage (CropGuides + spatial ×2) is optional in LTX Advanced." />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,8,0,0"
                            VerticalAlignment="Center"
                            Text="{x:Static lang:Resources.Label_Model}"
                            TextAlignment="Left" />
                        <controls:BetterComboBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,8,0,0"
                            Padding="8,6,4,6"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding ClientManager.Models}"
                            SelectedItem="{Binding SelectedModel}"
                            Theme="{StaticResource BetterComboBoxHybridModelTheme}" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="4,8,0,0"
                            VerticalAlignment="Stretch"
                            Command="{Binding OpenModelPickerCommand}"
                            ToolTip.Tip="Browse checkpoints / UNets">
                            <fluent:SymbolIcon FontSize="16" Symbol="Search" />
                        </Button>

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,8,0,0"
                            VerticalAlignment="Center"
                            Text="Gemma TE"
                            TextAlignment="Left" />
                        <controls:BetterDownloadableComboBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,8,0,0"
                            Padding="8,6,4,6"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding ClientManager.ClipModels}"
                            SelectedItem="{Binding SelectedClipModel}"
                            Theme="{StaticResource BetterComboBoxHybridModelTheme}" />
                        <Button
                            Grid.Row="2"
                            Grid.Column="2"
                            Margin="4,8,0,0"
                            VerticalAlignment="Stretch"
                            Command="{Binding OpenClipPickerCommand}"
                            ToolTip.Tip="Browse text encoders">
                            <fluent:SymbolIcon FontSize="16" Symbol="Search" />
                        </Button>

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,8,0,0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ShowTextProjection}"
                            Text="Text Proj"
                            TextAlignment="Left"
                            ToolTip.Tip="ltx-2.3_text_projection_bf16 — required for transformer-only packs" />
                        <controls:BetterDownloadableComboBox
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="0,8,0,0"
                            Padding="8,6,4,6"
                            HorizontalAlignment="Stretch"
                            IsVisible="{Binding ShowTextProjection}"
                            ItemsSource="{Binding ClientManager.ClipModels}"
                            SelectedItem="{Binding SelectedTextProjection}"
                            Theme="{StaticResource BetterComboBoxHybridModelTheme}" />
                        <Button
                            Grid.Row="3"
                            Grid.Column="2"
                            Margin="4,8,0,0"
                            VerticalAlignment="Stretch"
                            Command="{Binding OpenTextProjectionPickerCommand}"
                            IsVisible="{Binding ShowTextProjection}"
                            ToolTip.Tip="Browse text projection">
                            <fluent:SymbolIcon FontSize="16" Symbol="Search" />
                        </Button>

                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Margin="0,8,0,0"
                            VerticalAlignment="Center"
                            Text="{x:Static lang:Resources.Label_VAE}"
                            TextAlignment="Left"
                            ToolTip.Tip="2.3: taeltx2_3 / LTX23_video_vae. 2.5: ltx-2.5-video-vae-bf16." />
                        <ui:FAComboBox
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            DisplayMemberBinding="{Binding ShortDisplayName}"
                            IsTextSearchEnabled="True"
                            ItemsSource="{Binding ClientManager.VaeModels}"
                            SelectedItem="{Binding SelectedVae}" />
                        <Button
                            Grid.Row="4"
                            Grid.Column="2"
                            Margin="4,8,0,0"
                            VerticalAlignment="Stretch"
                            Command="{Binding OpenVaePickerCommand}">
                            <fluent:SymbolIcon FontSize="16" Symbol="Search" />
                        </Button>

                        <TextBlock
                            Grid.Row="5"
                            Grid.Column="0"
                            Margin="0,8,0,0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ShowShift}"
                            Text="Max Shift" />
                        <ui:NumberBox
                            Grid.Row="5"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            IsVisible="{Binding ShowShift}"
                            SimpleNumberFormat="F2"
                            SmallChange="0.05"
                            SpinButtonPlacementMode="Inline"
                            Value="{Binding MaxShift}" />

                        <TextBlock
                            Grid.Row="6"
                            Grid.Column="0"
                            Margin="0,8,0,0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ShowShift}"
                            Text="Base Shift" />
                        <ui:NumberBox
                            Grid.Row="6"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            IsVisible="{Binding ShowShift}"
                            SimpleNumberFormat="F2"
                            SmallChange="0.05"
                            SpinButtonPlacementMode="Inline"
                            Value="{Binding BaseShift}" />

                        <Panel
                            Grid.Row="7"
                            Grid.Column="0"
                            Grid.ColumnSpan="3">
                            <controls:StackEditableCard Margin="0,8,0,0" DataContext="{Binding ExtraNetworksStackCardViewModel}" />
                        </Panel>
                    </sg:SpacedGrid>
                </controls:Card>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
