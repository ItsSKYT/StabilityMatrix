<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StabilityMatrix.Avalonia.Controls"
    xmlns:controls1="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    xmlns:inference="clr-namespace:StabilityMatrix.Avalonia.ViewModels.Inference"
    x:DataType="inference:LtxvAdvancedOptionsCardViewModel">
    <Style Selector="controls|LtxvAdvancedOptionsCard">
        <Setter Property="Template">
            <ControlTemplate>
                <controls:Card Padding="8">
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontSize="16"
                            FontWeight="DemiBold"
                            Text="LTX Advanced" />

                        <TextBlock Opacity="0.8" Text="Resolution presets" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button
                                Command="{Binding ApplyPortraitPresetCommand}"
                                CommandParameter="landscape"
                                Content="768×512" />
                            <Button
                                Command="{Binding ApplyPortraitPresetCommand}"
                                CommandParameter="portrait"
                                Content="512×768" />
                            <Button
                                Command="{Binding ApplyPortraitPresetCommand}"
                                CommandParameter="portrait1080"
                                Content="1080×1920" />
                        </StackPanel>

                        <CheckBox
                            Content="Two-stage spatial upscale"
                            IsChecked="{Binding EnableTwoStage}"
                            ToolTip.Tip="2.3: low-res + upscaler + distilled LoRA. 2.5: always used (official ComfyUI ManualSigmas refine, no distilled LoRA). Resolution is stage 1; output is ×2." />
                        <StackPanel
                            Margin="16,0,0,0"
                            IsVisible="{Binding ShowTwoStageSettings}"
                            Spacing="6">
                            <TextBox Text="{Binding SpatialUpscalerName}" Watermark="Spatial upscaler filename (auto-detect if empty)" />
                            <TextBox Text="{Binding DistilledLoraName}" Watermark="Distilled LoRA filename (auto-detect if empty)" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock VerticalAlignment="Center" Text="LoRA strength" />
                                <controls1:NumberBox
                                    Width="100"
                                    Maximum="2"
                                    Minimum="0"
                                    SmallChange="0.05"
                                    Value="{Binding DistilledLoraStrength}" />
                                <TextBlock VerticalAlignment="Center" Text="Stage2 steps" />
                                <controls1:NumberBox
                                    Width="80"
                                    Maximum="30"
                                    Minimum="1"
                                    SmallChange="1"
                                    Value="{Binding Stage2Steps}" />
                            </StackPanel>
                        </StackPanel>

                        <CheckBox
                            Content="Temporal upscale (FPS)"
                            IsChecked="{Binding EnableTemporalUpscale}"
                            ToolTip.Tip="Requires ltx temporal upscaler model in latent_upscale_models." />
                        <TextBox
                            Margin="16,0,0,0"
                            IsVisible="{Binding ShowTemporalSettings}"
                            Text="{Binding TemporalUpscalerName}"
                            Watermark="Temporal upscaler filename" />

                        <CheckBox Content="Reference audio (ID-LoRA)" IsChecked="{Binding EnableReferenceAudio}" />
                        <StackPanel
                            Margin="16,0,0,0"
                            IsVisible="{Binding ShowReferenceAudio}"
                            Spacing="6">
                            <controls:SelectAudioCard DataContext="{Binding ReferenceAudioCard}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock VerticalAlignment="Center" Text="Identity guidance" />
                                <controls1:NumberBox
                                    Width="100"
                                    Maximum="20"
                                    Minimum="0"
                                    SmallChange="0.1"
                                    Value="{Binding IdentityGuidanceScale}" />
                            </StackPanel>
                        </StackPanel>

                        <CheckBox Content="Guide image (AddGuide)" IsChecked="{Binding EnableGuideImage}" />
                        <StackPanel
                            Margin="16,0,0,0"
                            IsVisible="{Binding ShowGuideImage}"
                            Spacing="6">
                            <controls:SelectImageCard DataContext="{Binding GuideImageCard}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock VerticalAlignment="Center" Text="Frame idx" />
                                <controls1:NumberBox
                                    Width="100"
                                    Maximum="9999"
                                    Minimum="-9999"
                                    Value="{Binding GuideFrameIdx}" />
                                <TextBlock VerticalAlignment="Center" Text="Strength" />
                                <controls1:NumberBox
                                    Width="100"
                                    Maximum="10"
                                    Minimum="0"
                                    SmallChange="0.05"
                                    Value="{Binding GuideStrength}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </controls:Card>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
